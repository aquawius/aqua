{
  "name": "aqua",
  "version": "0.4.0",
  "builtin-baseline": "e456309491fd875487bf02b8a0dca76c1b1b00cc",
  "dependencies": [
    "spdlog",
    "cxxopts",
    "grpc",
    "asio"
  ],
  "default-features": [],
  "features": {
    "tests": {
      "description": "Build tests (GoogleTest)",
      "dependencies": [
        "gtest"
      ]
    },
    "gui": {
      "description": "Build the desktop GUI client (Dear ImGui + SDL3)",
      "dependencies": [
        {
          "name": "imgui",
          "default-features": false,
          "features": [
            "sdl3-binding",
            "sdl3-renderer-binding"
          ],
          "platform": "(windows | linux | osx)"
        },
        {
          "name": "sdl3",
          "platform": "(windows | linux | osx)"
        }
      ]
    }
  }
}
