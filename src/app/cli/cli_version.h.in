// 版本号模板：由 CMake configure_file 生成 <build>/app/cli/cli_version.h
// 本头只承载 CLI 前端版本，与 core 解耦

#ifndef AQUA_CLI_VERSION_H
#define AQUA_CLI_VERSION_H

// 服务端 CLI 版本（aqua_server --version 输出）。
#define AQUA_SERVER_CLI_VERSION "@AQUA_SERVER_CLI_VERSION@"

// 客户端 CLI 版本（aqua_client --version 输出）。
#define AQUA_CLIENT_CLI_VERSION "@AQUA_CLIENT_CLI_VERSION@"

#endif // AQUA_CLI_VERSION_H
